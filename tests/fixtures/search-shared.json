[
  {
    "name": "literal forward CRLF",
    "request": {
      "text": "red\r\nblue red",
      "pattern": "red",
      "action": "find",
      "from": 1,
      "to": 1
    },
    "expected": {
      "count": 2,
      "from": 10,
      "to": 13
    }
  },
  {
    "name": "literal backward wrap",
    "request": {
      "text": "red blue red",
      "pattern": "red",
      "action": "find",
      "direction": -1,
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "from": 9,
      "to": 12
    }
  },
  {
    "name": "case insensitive",
    "request": {
      "text": "Cat cat CAT",
      "pattern": "cat",
      "action": "find",
      "ignoreCase": true,
      "from": 4,
      "to": 4
    },
    "expected": {
      "count": 3,
      "from": 4,
      "to": 7
    }
  },
  {
    "name": "literal replacement",
    "request": {
      "text": "a.b a.b",
      "pattern": ".",
      "replacement": "-",
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": "a-b a-b",
      "from": 5,
      "to": 6
    }
  },
  {
    "name": "replacement capture and escapes",
    "request": {
      "text": "name=1 cat=2",
      "pattern": "(\\w+)=(\\d+)",
      "regex": true,
      "replacement": "$2:$1\\t",
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": "1:name\t 2:cat\t",
      "from": 8,
      "to": 14
    }
  },
  {
    "name": "regex lookbehind",
    "request": {
      "text": "foo123 foo45",
      "pattern": "(?<=foo)(\\d+)",
      "replacement": "[$1]",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": "foo[123] foo[45]",
      "from": 12,
      "to": 16
    }
  },
  {
    "name": "empty replacement",
    "request": {
      "text": "old old",
      "pattern": "old",
      "replacement": "",
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": " ",
      "from": 1,
      "to": 1
    }
  },
  {
    "name": "zero width start",
    "request": {
      "text": "a\nb",
      "pattern": "^",
      "replacement": "> ",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": "> a\n> b",
      "from": 4,
      "to": 6
    }
  },
  {
    "name": "not found",
    "request": {
      "text": "hello",
      "pattern": "world",
      "action": "find",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 0
    }
  },
  {
    "name": "replace matched selection",
    "request": {
      "text": "one one",
      "pattern": "one",
      "replacement": "two",
      "action": "replace",
      "from": 4,
      "to": 7
    },
    "expected": {
      "count": 1,
      "text": "one two",
      "from": 4,
      "to": 7
    }
  },
  {
    "name": "replace unmatched finds next",
    "request": {
      "text": "one one",
      "pattern": "one",
      "replacement": "two",
      "action": "replace",
      "from": 1,
      "to": 1
    },
    "expected": {
      "count": 2,
      "from": 4,
      "to": 7
    }
  },
  {
    "name": "single CRLF, LF and CR are not treated as multiple breaks",
    "request": {
      "text": "A\r\nB\nC\rD",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 0
    }
  },
  {
    "name": "collapse CRLF without changing other CRLF",
    "request": {
      "text": "a\r\n\r\nb\r\nc",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 1,
      "text": "a\r\nb\r\nc",
      "from": 1,
      "to": 3
    }
  },
  {
    "name": "collapse three LF and keep a single LF",
    "request": {
      "text": "a\n\n\nb\nc",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 1,
      "text": "a\nb\nc",
      "from": 1,
      "to": 2
    }
  },
  {
    "name": "collapse CR and keep a single CR",
    "request": {
      "text": "a\r\rb\rc",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 1,
      "text": "a\rb\rc",
      "from": 1,
      "to": 2
    }
  },
  {
    "name": "collapse mixed line endings using the first break",
    "request": {
      "text": "A\r\n\nB\r\r\nC\n\rD\r\nE",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 3,
      "text": "A\r\nB\rC\nD\r\nE",
      "from": 6,
      "to": 7
    }
  },
  {
    "name": "replace one selected pair of CRLF breaks",
    "request": {
      "text": "A\r\n\r\nB",
      "pattern": "(\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)(?:\\r\\n|\\r(?!\\n)|(?<!\\r)\\n)+",
      "replacement": "$1",
      "regex": true,
      "action": "replace",
      "from": 1,
      "to": 5
    },
    "expected": {
      "count": 1,
      "text": "A\r\nB",
      "from": 1,
      "to": 3
    }
  },
  {
    "name": "Japanese named group replacement",
    "request": {
      "text": "猫 猫",
      "pattern": "(?<単語>猫)",
      "replacement": "<${単語}>",
      "regex": true,
      "action": "all",
      "from": 0,
      "to": 0
    },
    "expected": {
      "count": 2,
      "text": "<猫> <猫>",
      "from": 4,
      "to": 7
    }
  }
]
