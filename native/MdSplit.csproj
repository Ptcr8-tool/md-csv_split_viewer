<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MD-Split</AssemblyName>
    <RootNamespace>MdSplit</RootNamespace>
    <Version>1.1.0</Version>
    <Product>MD-CSV Split Editor</Product>
    <Description>Text, Markdown and CSV editor</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/src</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="update-public.pem" LogicalName="MdSplit.UpdatePublicKey.pem" />
    <EmbeddedResource Include="obj/update-verifier/pins.json" LogicalName="MdSplit.UpdateVerifierPins.json" Condition="Exists('obj/update-verifier/pins.json')" />
    <Content Include="obj/update-verifier/gh.exe" TargetPath="update-verifier/gh.exe" CopyToPublishDirectory="PreserveNewest" Condition="Exists('obj/update-verifier/gh.exe')" />
    <Content Include="obj/update-verifier/trusted_root.jsonl" TargetPath="update-verifier/trusted_root.jsonl" CopyToPublishDirectory="PreserveNewest" Condition="Exists('obj/update-verifier/trusted_root.jsonl')" />
    <Content Include="obj/update-verifier/LICENSE.txt" TargetPath="update-verifier/LICENSE.txt" CopyToPublishDirectory="PreserveNewest" Condition="Exists('obj/update-verifier/LICENSE.txt')" />
    <Content Include="obj/update-verifier/THIRD_PARTY_LICENSES.txt" TargetPath="update-verifier/THIRD_PARTY_LICENSES.txt" CopyToPublishDirectory="PreserveNewest" Condition="Exists('obj/update-verifier/THIRD_PARTY_LICENSES.txt')" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="..\dist\**\*" Exclude="..\dist\**\*.map" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="doc-icons\*.ico" TargetPath="doc-icons-v2\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedWpfAssembly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>


